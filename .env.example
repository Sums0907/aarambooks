# Server Configuration
PORT=8000
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/aarambooks
DATABASE_URL_SYNC=postgresql://user:pass@localhost:5432/aarambooks
# NDR communications/outbox storage (CustomerEngagementRepository, outbound_writeback_queue).
# Defaults to mongodb://localhost:27017 if unset - only correct when Mongo runs on the same
# host as Brain itself. In docker-compose.prod.yml this points at the aarambooks-brain-mongo
# service instead.
MONGO_URI=mongodb://localhost:27017

# AI Infrastructure
LITELLM_MASTER_KEY=sk-1234
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MODEL=local-qwen
GEMINI_API_KEY=AIzaSy...

# Stage-Based Multi-LLM Routing
STAGE_R_1_INTENT_ROUTING_MODEL=local-qwen
STAGE_R_2_PLANNING_MODEL=local-qwen
STAGE_R_5_ENTITY_RESOLUTION_MODEL=local-qwen
STAGE_R_7_RESPONSE_SYNTHESIS_MODEL=local-qwen
STAGE_5_ANALYTICS_ENGINE_MODEL=local-qwen
STAGE_6_EXECUTIVE_REPORTS_MODEL=gemini-3.6-flash

# External Ecosystem
IDENTITY_URL=https://api-identity.aarambooks.cloud
INVENTORY_URL=https://api-inventory.aarambooks.cloud
# Catalog BS - reached only over HTTP (see src/infrastructure/adapters/catalog_cem_adapter.py
# and business_systems/catalog/api.py). Local dev default assumes
# `uvicorn business_systems.catalog.api:app --port 8300` running separately.
CATALOG_URL=http://localhost:8300
CATALOG_INTERNAL_TOKEN=change_me_shared_secret
PACKING_URL=https://api-packing.aarambooks.cloud
SHIPROCKET_TOKEN=your_shiprocket_jwt
SHOPDECK_TOKEN=your_shopdeck_session
BRAIN_CLIENT_ID=your_staging_m2m_client_id
BRAIN_CLIENT_SECRET=your_staging_m2m_client_secret

# Exotel VoiceBot Configuration
EXOTEL_ACCOUNT_SID=your_exotel_account_sid
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
EXOTEL_CALLER_ID=your_exotel_caller_id
EXOTEL_VOICEBOT_FLOW_URL=your_exotel_voicebot_flow_url
AARAM_EXOTEL_WEBHOOK_SECRET=your_secure_webhook_secret
