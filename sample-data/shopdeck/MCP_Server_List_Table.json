{"path":"/ShopDeck MCP Reader/link_6a8e9b48c7588191a0ea4fdcf0649180/list_tables","args":{}}

//Response

{"text":"[\n  {\n    \"table_name\": \"order_summary\",\n    \"description\": \"Stores detailed information about customer orders, including payment details, total amounts, discounts, and associated user and session tracking data.\",\n    \"columns\": [\n      {\n        \"column\": \"order_id\",\n        \"type\": \"STRING\",\n        \"description\": \"A unique identifier for each order.\"\n      },\n      {\n        \"column\": \"payment_mode\",\n        \"type\": \"STRING\",\n        \"description\": \"The method of payment used for the order (e.g., Credit Card, UPI, COD).\"\n      },\n      {\n        \"column\": \"total_aggr_discount\",\n        \"type\": \"FLOAT\",\n        \"description\": \"The total aggregated discount applied to the order, expressed as a monetary value.\"\n      },\n      {\n        \"column\": \"payment_status\",\n        \"type\": \"BOOLEAN\",\n        \"description\": \"A boolean indicating the success (true) or failure (false) of the payment for the order.\"\n      },\n      {\n        \"column\": \"return_order_item_id\",\n        \"type\": \"STRING\",\n        \"description\": \"An identifier for a specific item within an order that has been returned. Null if no return is associated.\"\n      },\n      {\n        \"column\": \"total_amount\",\n        \"type\": \"FLOAT\",\n        \"description\": \"The final total monetary amount of the order, including taxes and after all discounts.\"\n      },\n      {\n        \"column\": \"updatedat\",\n        \"type\": \"TIMESTAMP\",\n        \"description\": \"The timestamp when the order record was last updated.\"\n      },\n      {\n        \"column\": \"createdat\",\n        \"type\": \"TIMESTAMP\",\n        \"description\": \"The timestamp when the order record was first created.\"\n      },\n      {\n        \"column\": \"user_agent\",\n        \"type\": \"STRING\",\n        \"description\": \"The user-agent string from the client's browser or device used to place the order.\"\n      },\n      {\n        \"column\": \"user_ip_address\",\n        \"type\": \"STRING\",\n        \"description\": \"The IP address of the user when the order was placed.\"\n      },\n      {\n        \"column\": \"fb_analytics_attributes_fbc\",\n        \"type\": \"STRING\",\n        \"description\": \"Facebook click identifier (fbc) for analytics tracking, linking user activity to ad clicks.\"\n      },\n      {\n        \"column\": \"fb_analytics_attributes_fbp\",\n        \"type\": \"STRING\",\n        \"description\": \"Facebook browser ID (fbp) for analytics tracking, identifying a user's browser.\"\n      },\n      {\n        \"column\": \"fb_analytics_attributes_external_id\",\n        \"type\": \"STRING\",\n        \"description\": \"An external ID used for Facebook analytics, often a hashed user ID or other unique identifier.\"\n      },\n      {\n        \"column\": \"visitor_id\",\n        \"type\": \"STRING\",\n        \"description\": \"A unique identifier for the website visitor who placed the order.\"\n      },\n      {\n        \"column\": \"session_id\",\n        \"type\": \"STRING\",\n        \"description\": \"A unique identifier for the user's browsing session during which the order was placed.\"\n      },\n      {\n        \"column\": \"checkout_session_id\",\n        \"type\": \"STRING\",\n        \"description\": \"A unique identifier for the specific checkout session that led to this order.\"\n      }\n    ]\n  },\n  {\n    \"table_name\": \"order_line_items\",\n    \"description\": \"Stores detailed information about individual customer orders, including product details, pricing, payment status, shipping logistics, and order lifecycle events such as creation, updates, delivery, cancellation, and returns.\",\n    \"columns\": [\n      {\n        \"column\": \"order_id\",\n        \"type\": \"STRING\",\n        \"description\": \"A unique identifier for each order.\"\n      },\n      {\n        \"column\": \"seller_group_id\",\n        \"type\": \"STRING\",\n        \"description\": \"A unique identifier for the order item. Multiple order items can belong to a single order.\"\n      },\n      {\n        \"column\": \"sku_id\",\n        \"type\": \"STRING\",\n        \"description\": \"The Stock Keeping Unit (SKU) identifier for the specific product variant ordered.\"\n      },\n      {\n        \"column\": \"payment_mode\",\n        \"type\": \"STRING\",\n        \"description\": \"The method of payment used for the order. The possible values for this column are: cod, partial-cod, prepaid, online\"\n      },\n      {\n        \"column\": \"is_deal\",\n        \"type\": \"BOOLEAN\",\n        \"description\": \"A boolean flag indicating whether the order was placed as part of a special deal or promotion.\"\n      },\n      {\n        \"column\": \"platform\",\n        \"type\": \"STRING\",\n        \"description\": \"The platform or channel through which the order was placed. Possible values for this column are: dashboard, web, android, customer_app\"\n      },\n      {\n        \"column\": \"seller_payment_state\",\n        \"type\": \"STRING\",\n        \"description\": \"The current payment status from the seller's perspective. Possible values of this column are: pending, unbilled, partially-billed, billed, reversed, partially-billed-reversed\"\n      },\n      {\n        \"column\": \"reseller_payment_state\",\n        \"type\": \"STRING\",\n        \"description\": \"The current payment status from the reseller's perspective, if applicable. Possible values for this column are: pending, unbilled, partially-billed, billed, reversed, partially-billed-reversed\"\n      },\n      {\n        \"column\": \"customer_last_status\",\n        \"type\": \"STRING\",\n        \"description\": \"The last known status of the order as visible to the customer.\"\n      },\n      {\n        \"column\": \"seller_last_status\",\n        \"type\": \"STRING\",\n        \"description\": \"The last known status of the order as visible to the seller. Possible values of this column are: paused, initiated, enqueued, created, printed, packed, dispatched, delivered, rto_initiated, rto_delivered, rto_acknowledged, cancelled, cancel_initiated, lost, exchange_pickup, exhange_dispatched, exchange_delivered, invalid\"\n      },\n      {\n        \"column\": \"total_discount\",\n        \"type\": \"FLOAT\",\n        \"description\": \"The total monetary discount applied to the entire order.\"\n      },\n      {\n        \"column\": \"customer_id\",\n        \"type\": \"STRING\",\n        \"description\": \"A unique identifier for the customer who placed the order.\"\n      },\n      {\n        \"column\": \"quantity\",\n        \"type\": \"INTEGER\",\n        \"description\": \"The number of units of the product ordered.\"\n      },\n      {\n        \"column\": \"awb_no\",\n        \"type\": \"STRING\",\n        \"description\": \"The Air Waybill (AWB) number or tracking number for the shipment.\"\n      },\n      {\n        \"column\": \"customer_name\",\n        \"type\": \"STRING\",\n        \"description\": \"The full name of the customer.\"\n      },\n      {\n        \"column\": \"seller_price\",\n        \"type\": \"FLOAT\",\n        \"description\": \"The base price of the product as set by the seller before any discounts or fees.\"\n      },\n      {\n        \"column\": \"selling_price\",\n        \"type\": \"FLOAT\",\n        \"description\": \"The final price at which the product was sold to the customer, after applying discounts but before delivery fees or COD charges.\"\n      },\n      {\n        \"column\": \"customer_product_short_id\",\n        \"type\": \"STRING\",\n        \"description\": \"A short identifier for the product, potentially used for customer-facing displays.\"\n      },\n      {\n        \"column\": \"customer_sku_short_id\",\n        \"type\": \"STRING\",\n        \"description\": \"A short identifier for the SKU, potentially used for customer-facing displays.\"\n      },\n      {\n        \"column\": \"product_id\",\n        \"type\": \"STRING\",\n        \"description\": \"Unique identifier of the product ordered. Never populated — NULL in every row since 2023.\"\n      },\n      {\n        \"column\": \"seller_id\",\n        \"type\": \"STRING\",\n        \"description\": \"A unique identifier for the seller of the product.\"\n      },\n      {\n        \"column\": \"seller_name\",\n        \"type\": \"STRING\",\n        \"description\": \"The name of the seller.\"\n      },\n      {\n        \"column\": \"pincode\",\n        \"type\": \"STRING\",\n        \"description\": \"The postal code or pincode of the delivery address.\"\n      },\n      {\n        \"column\": \"updatedat\",\n        \"type\": \"TIMESTAMP\",\n        \"description\": \"The timestamp when the order record was last updated.\"\n      },\n      {\n        \"column\": \"createdat\",\n        \"type\": \"TIMESTAMP\",\n        \"description\": \"The timestamp when the order record was first created.\"\n      },\n      {\n        \"column\": \"lattitude\",\n        \"type\": \"STRING\",\n        \"description\": \"The geographical latitude of the delivery location.\"\n      },\n      {\n        \"column\": \"longitude\",\n        \"type\": \"STRING\",\n        \"description\": \"The geographical longitude of the delivery location.\"\n      },\n      {\n        \"column\": \"delivery_time\",\n        \"type\": \"TIMESTAMP\",\n        \"description\": \"The actual timestamp when the order was delivered to the customer.\"\n      },\n      {\n        \"column\": \"rto_initiated\",\n        \"type\": \"TIMESTAMP\",\n        \"description\": \"The timestamp when a Return to Origin (RTO) process was initiated for the order.\"\n      },\n      {\n        \"column\": \"coupon_code\",\n        \"type\": \"STRING\",\n        \"description\": \"The promotional coupon code applied to the order.\"\n      },\n      {\n        \"column\": \"rto_delivered_at\",\n        \"type\": \"TIMESTAMP\",\n        \"description\": \"The timestamp when the RTO package was delivered back to the origin (e.g., warehouse or seller).\"\n      },\n      {\n        \"column\": \"seller_clubbed_id\",\n        \"type\": \"STRING\",\n        \"description\": \"An identifier for order items that are clubbed together i.e., they are shipped and delivered together. This field can be joined by seller_clubbed_id in cluborders.\"\n      },\n      {\n        \"column\": \"pickup_time\",\n        \"type\": \"TIMESTAMP\",\n        \"description\": \"The timestamp when the order was picked up by the logistics partner for delivery.\"\n      },\n      {\n        \"column\": \"cod_charge\",\n        \"type\": \"FLOAT\",\n        \"description\": \"The additional charge applied for Cash on Delivery (COD) payment mode.\"\n      },\n      {\n        \"column\": \"delivery_fees\",\n        \"type\": \"FLOAT\",\n        \"description\": \"The fees charged for delivering the order.\"\n      },\n      {\n        \"column\": \"online_discount\",\n        \"type\": \"FLOAT\",\n        \"description\": \"The discount specifically applied for online payment methods.\"\n      },\n      {\n        \"column\": \"coupon_id\",\n        \"type\": \"STRING\",\n        \"description\": \"A unique identifier for the coupon used.\"\n      },\n      {\n        \"column\": \"coupon_type\",\n        \"type\": \"STRING\",\n        \"description\": \"The type of coupon applied. Possible values for this field are: bumper, repeat-user, retargeting, community, generic, repeat_user_coupons, free_gift\"\n      },\n      {\n        \"column\": \"coupon_discount\",\n        \"type\": \"FLOAT\",\n        \"description\": \"The monetary discount amount provided by the coupon.\"\n      },\n      {\n        \"column\": \"expected_delivery_date\",\n        \"type\": \"TIMESTAMP\",\n        \"description\": \"The anticipated date for the delivery of the order.\"\n      },\n      {\n        \"column\": \"prepaid_amount\",\n        \"type\": \"FLOAT\",\n        \"description\": \"The amount paid by the customer in advance for prepaid orders.\"\n      },\n      {\n        \"column\": \"logistics_reference_number\",\n        \"type\": \"STRING\",\n        \"description\": \"A reference number provided by the logistics partner for tracking or internal use.\"\n      },\n      {\n        \"column\": \"in_house_status\",\n        \"type\": \"STRING\",\n        \"description\": \"The internal status of the order within the company's system.\"\n      },\n      {\n        \"column\": \"tpl_rates_template_id\",\n        \"type\": \"STRING\",\n        \"description\": \"Identifier for the Third-Party Logistics (TPL) rates template used for shipping cost calculation.\"\n      },\n      {\n        \"column\": \"latest_awb_time\",\n        \"type\": \"TIMESTAMP\",\n        \"description\": \"The most recent timestamp associated with the Air Waybill (AWB) status update.\"\n      },\n      {\n        \"column\": \"product_name\",\n        \"type\": \"STRING\",\n        \"description\": \"The name of the product ordered.\"\n      },\n      {\n        \"column\": \"pod_url\",\n        \"type\": \"STRING\",\n        \"description\": \"A URL pointing to the Proof of Delivery (POD) document or image.\"\n      },\n      {\n        \"column\": \"cancelled_by\",\n        \"type\": \"STRING\",\n        \"description\": \"Indicates who initiated the cancellation of the order. Possible values of this field are: seller, customer, system\"\n      },\n      {\n        \"column\": \"cancellation_reason_code\",\n        \"type\": \"STRING\",\n        \"description\": \"A code indicating the specific reason for the order cancellation.\"\n      },\n      {\n        \"column\": \"cancel_remarks\",\n        \"type\": \"STRING\",\n        \"description\": \"Additional remarks or notes regarding the cancellation of the order.\"\n      },\n      {\n        \"column\": \"cancellation_source\",\n        \"type\": \"STRING\",\n        \"description\": \"The source system or interface from which the cancellation request originated.\"\n      },\n      {\n        \"column\": \"payment_status\",\n        \"type\": \"STRING\",\n        \"description\": \"The overall payment status of the order (e.g., 'Paid', 'Pending', 'Refunded').\"\n      },\n      {\n        \"column\": \"cancel_time\",\n        \"type\": \"TIMESTAMP\",\n        \"description\": \"The timestamp when the order was officially cancelled.\"\n      },\n      {\n        \"column\": \"exchange_charge\",\n        \"type\": \"INTEGER\",\n        \"description\": \"Any additional charge applied for processing a product exchange.\"\n      },\n      {\n        \"column\": \"is_exchange_order\",\n        \"type\": \"BOOLEAN\",\n        \"description\": \"A boolean flag indicating whether this order is an exchange order.\"\n      },\n      {\n        \"column\": \"product_color\",\n        \"type\": \"STRING\",\n        \"description\": \"The color of the product ordered.\"\n      },\n      {\n        \"column\": \"product_size\",\n        \"type\": \"STRING\",\n        \"description\": \"The size of the product ordered.\"\n      },\n      {\n        \"column\": \"product_return_condition\",\n        \"type\": \"STRING\",\n        \"description\": \"The specified condition of the product for a return to be accepted.\"\n      },\n      {\n        \"column\": \"rto_requested_time\",\n        \"type\": \"TIMESTAMP\",\n        \"description\": \"The timestamp when the Return to Origin (RTO) was requested by the logistics partner or system.\"\n      },\n      {\n        \"column\": \"is_return_initiated\",\n        \"type\": \"BOOLEAN\",\n        \"description\": \"A boolean flag indicating if a return process has been initiated for this order.\"\n      },\n      {\n        \"column\": \"cod_remittance_id\",\n        \"type\": \"STRING\",\n        \"description\": \"Identifier for the Cash on Delivery (COD) remittance transaction.\"\n      },\n      {\n        \"column\": \"cod_remittance_date\",\n        \"type\": \"TIMESTAMP\",\n        \"description\": \"The date when the Cash on Delivery (COD) amount was remitted.\"\n      },\n      {\n        \"column\": \"billing_invoice_id\",\n        \"type\": \"STRING\",\n        \"description\": \"The unique identifier for the billing invoice generated for the order.\"\n      },\n      {\n        \"column\": \"is_return_created\",\n        \"type\": \"BOOLEAN\",\n        \"description\": \"A boolean flag indicating if a return record has been formally created in the system.\"\n      },\n      {\n        \"column\": \"shipping_label\",\n        \"type\": \"STRING\",\n        \"description\": \"Details or a reference to the shipping label generated for the order.\"\n      },\n      {\n        \"column\": \"wm_invoice_shipping_label_url\",\n        \"type\": \"STRING\",\n        \"description\": \"A URL to the shipping label associated with the warehouse management invoice.\"\n      },\n      {\n        \"column\": \"order_last_error\",\n        \"type\": \"STRING\",\n        \"description\": \"The last error message encountered related to the order processing or status.\"\n      },\n      {\n        \"column\": \"manifest_short_id\",\n        \"type\": \"STRING\",\n        \"description\": \"A short identifier for the shipping manifest associated with the order.\"\n      },\n      {\n        \"column\": \"refund_status\",\n        \"type\": \"STRING\",\n        \"description\": \"The current status of any refund initiated for the order. Possible values of this field are: initiated, success, failure, pending, no_refund, paid_by_seller, not_applicable, queued, cancelled_by_seller, retrying\"\n      },\n      {\n        \"column\": \"earlier_state_cancel\",\n        \"type\": \"STRING\",\n        \"description\": \"The state of the order immediately prior to its cancellation.\"\n      },\n      {\n        \"column\": \"product_price\",\n        \"type\": \"FLOAT\",\n        \"description\": \"The base price of the product before any discounts or specific selling prices are applied.\"\n      },\n      {\n        \"column\": \"product_customisation\",\n        \"type\": \"STRING\",\n        \"description\": \"Details regarding any customization applied to the product.\"\n      },\n      {\n        \"column\": \"inhouse_courier_name\",\n        \"type\": \"STRING\",\n        \"description\": \"The name of the in-house courier service used for delivery, if applicable.\"\n      },\n      {\n        \"column\": \"meta\",\n        \"type\": \"STRING\",\n        \"description\": \"A field for storing additional metadata or unstructured information related to the order, typically in JSON or string format.\"\n      },\n      {\n        \"column\": \"call_status\",\n        \"type\": \"STRING\",\n        \"description\": \"The status related to customer service calls made concerning this order.\"\n      },\n      {\n        \"column\": \"duplicate_flag\",\n        \"type\": \"BOOLEAN\",\n        \"description\": \"Whether this line item was flagged as a duplicate of another order item (roughly 3% of rows are true).\"\n      },\n      {\n        \"column\": \"order_acceptance_type\",\n        \"type\": \"STRING\",\n        \"description\": \"How the order was accepted (auto or manual).\"\n      },\n      {\n        \"column\": \"order_accepted_at\",\n        \"type\": \"TIMESTAMP\",\n        \"description\": \"UTC timestamp when the order was accepted.\"\n      },\n      {\n        \"column\": \"shopdeck_warehouse_address_id\",\n        \"type\": \"STRING\",\n        \"description\": \"Identifier of the Shopdeck warehouse address the item ships from. Rarely populated — NULL in over 99% of rows.\"\n      },\n      {\n        \"column\": \"pickup_pincode\",\n        \"type\": \"STRING\",\n        \"description\": \"Pincode the shipment is picked up from (e.g., 302029, 395010).\"\n      },\n      {\n        \"column\": \"courier_allocation_type\",\n        \"type\": \"STRING\",\n        \"description\": \"How the courier was allocated (rule_based_allocation, manual_selection, recommended, custom). NULL when no courier was allocated.\"\n      }\n    ]\n  },\n  {\n    \"table_name\": \"customer_info\",\n    \"description\": \"One row per customer shipment: the customer and their contact number, the seller's pickup address, and the delivery destination, keyed by AWB number. Use it to look up who an order went to and where it was shipped from and to. Note that customer_number is stored encrypted and is decrypted only on the way out, in the rows returned to you — so filtering, joining or grouping on it matches ciphertext and will not work, and selecting it under a different name (SELECT customer_number AS phone) returns it still encrypted. Select it as customer_number and do any matching on customer_id or awb_no instead.\",\n    \"columns\": [\n      {\n        \"column\": \"seller_group_id\",\n        \"type\": \"STRING\",\n        \"description\": \"Identifier of the seller group (the storefront) the shipment was placed on.\"\n      },\n      {\n        \"column\": \"awb_no\",\n        \"type\": \"STRING\",\n        \"description\": \"The carrier's air waybill (tracking) number for the shipment.\"\n      },\n      {\n        \"column\": \"seller_id\",\n        \"type\": \"STRING\",\n        \"description\": \"The seller the shipment belongs to. Rows are always restricted to the calling seller on this column.\"\n      },\n      {\n        \"column\": \"customer_id\",\n        \"type\": \"STRING\",\n        \"description\": \"A unique identifier for the customer the shipment was sent to.\"\n      },\n      {\n        \"column\": \"customer_number\",\n        \"type\": \"STRING\",\n        \"description\": \"The customer's contact number. Stored encrypted and decrypted in the returned rows only, so it cannot be filtered, joined or grouped on, and must be selected under this exact name to come back readable.\"\n      },\n      {\n        \"column\": \"pickup_address_id\",\n        \"type\": \"STRING\",\n        \"description\": \"Identifier of the seller's pickup address the shipment was collected from.\"\n      },\n      {\n        \"column\": \"pickup_city\",\n        \"type\": \"STRING\",\n        \"description\": \"City of the seller's pickup address.\"\n      },\n      {\n        \"column\": \"pickup_state\",\n        \"type\": \"STRING\",\n        \"description\": \"State of the seller's pickup address.\"\n      },\n      {\n        \"column\": \"pickup_pincode\",\n        \"type\": \"STRING\",\n        \"description\": \"Postal PIN code of the seller's pickup address.\"\n      },\n      {\n        \"column\": \"pickup_phone\",\n        \"type\": \"STRING\",\n        \"description\": \"Contact phone number registered on the seller's pickup address (not the customer's number).\"\n      },\n      {\n        \"column\": \"drop_pincode\",\n        \"type\": \"STRING\",\n        \"description\": \"Postal PIN code the shipment was delivered to.\"\n      },\n      {\n        \"column\": \"drop_city\",\n        \"type\": \"STRING\",\n        \"description\": \"City the shipment was delivered to.\"\n      },\n      {\n        \"column\": \"drop_state\",\n        \"type\": \"STRING\",\n        \"description\": \"State the shipment was delivered to.\"\n      },\n      {\n        \"column\": \"createdat\",\n        \"type\": \"TIMESTAMP\",\n        \"description\": \"The timestamp when the row was created. This is the table's partitioning column.\"\n      },\n      {\n        \"column\": \"updatedat\",\n        \"type\": \"TIMESTAMP\",\n        \"description\": \"The timestamp when the row was last updated.\"\n      }\n    ]\n  },\n  {\n    \"table_name\": \"add_to_bag_events\",\n    \"description\": \"Captures event data whenever a customer clicks the 'Add To Bag' button on a product on a seller's website. Each event logs details about the selected product(s), customer's browsing context, session details, and associated marketing campaign attribution.\",\n    \"columns\": [\n      {\n        \"column\": \"product_id\",\n        \"type\": \"STRING\",\n        \"description\": \"Unique identifier of the product involved in the event.\"\n      },\n      {\n        \"column\": \"price\",\n        \"type\": \"FLOAT\",\n        \"description\": \"Price of the product in rupees at the time of the event.\"\n      },\n      {\n        \"column\": \"mode\",\n        \"type\": \"STRING\",\n        \"description\": \"Storefront surface the action was performed from (e.g., product_page, product_card, collection_page).\"\n      },\n      {\n        \"column\": \"screen_source\",\n        \"type\": \"STRING\",\n        \"description\": \"Source through which product page was reached (e.g., product_group_best_sellers).\"\n      },\n      {\n        \"column\": \"platform\",\n        \"type\": \"STRING\",\n        \"description\": \"Platform used (customer_app or web).\"\n      },\n      {\n        \"column\": \"language\",\n        \"type\": \"STRING\",\n        \"description\": \"shows the user's browser language setting \"\n      },\n      {\n        \"column\": \"browserVer\",\n        \"type\": \"STRING\",\n        \"description\": \"Version of the browser used by the customer.\"\n      },\n      {\n        \"column\": \"useragent\",\n        \"type\": \"STRING\",\n        \"description\": \"User-agent header string of the customer's browser\"\n      },\n      {\n        \"column\": \"connectionEffectiveType\",\n        \"type\": \"STRING\",\n        \"description\": \"Effective network connection type (e.g., 3g, 4g, 5g).\"\n      },\n      {\n        \"column\": \"connectionSaveData\",\n        \"type\": \"BOOLEAN\",\n        \"description\": \"Indicates whether the user has enabled a data-saving mode\"\n      },\n      {\n        \"column\": \"connectionRtt\",\n        \"type\": \"FLOAT\",\n        \"description\": \"Indicates th