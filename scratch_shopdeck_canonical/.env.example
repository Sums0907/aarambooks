# =========================================================
# ShopDeck Production VPS Environment Configuration
# =========================================================

# 1. Database Connections
DATABASE_URL=postgresql://user:password@localhost:5432/shopdeck_db
DATABASE_URL_SYNC=postgresql://user:password@localhost:5432/shopdeck_db

# 2. ShopDeck Vendor Integration
SHOPDECK_MCP_URL=https://mcp.shopdeck.com/mcp
SHOPDECK_MCP_TOKEN=mcp_at_xxxxxxxxxxxxxxxxxxxxxxxxxxx

# 3. Aaram Ecosystem Configuration
# (Optional overrides - if left commented, config.py will default to these production URLs automatically)
# IDENTITY_API_URL=https://api-identity.aarambooks.cloud
# SHOPDECK_MCP_REQUEST_TIMEOUT=120
# SHOPDECK_AWB_BATCH_SIZE=500
