FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Catalog is reached only over HTTP now (see src/infrastructure/adapters/catalog_cem_adapter.py
# and business_systems/catalog/api.py) - Brain no longer imports business_systems.catalog
# directly, so business_systems/ never needs to be in this image at all. Set CATALOG_URL to
# wherever that service is actually deployed.
COPY src/ ./src/
COPY litellm_config.prod.yaml ./litellm_config.yaml

ENV PYTHONPATH=/app
EXPOSE 8000

CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000"]
